# ---- Basic認証（必須。本番環境では未設定だと起動しません） ----
# パスワードのみで認証します（ユーザー名は不要。ブラウザの入力欄は空欄のままで構いません）。
# 値はここに書かず、.env.local またはホスティング環境の環境変数に設定してください。12文字以上。
BASIC_AUTH_PASSWORD=

# ---- APIキー暗号化用の鍵（必須。32バイトを base64 または 16進数64文字で） ----
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# この鍵を変更すると、保存済みのAPIキーは復号できなくなります（再登録が必要）。
API_KEY_ENCRYPTION_KEY=

# ---- データベース（Vercel では必須） ----
# PostgreSQL の接続文字列。Vercel の Neon 連携などで自動設定される DATABASE_URL（または POSTGRES_URL）を使います。
# 未設定の場合は、ローカル用の組み込み Postgres（PGlite）を RESEARCH_DATA_DIR に保存して使います。
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ---- 実験ワーカー用のシークレット（Vercel では必須。16文字以上のランダムな値） ----
# Vercel Cron と、処理を次の関数実行に引き継ぐ自己呼び出しの認証に使います。
# 生成例: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# CRON_SECRET=

# ---- 任意 ----
# ローカル用の組み込み Postgres の保存先。既定: .data/research
# RESEARCH_DATA_DIR=
# 1回の処理（スライス）の時間予算（秒）。関数の最大実行時間（300秒）より短くしてください。既定: 200
# RESEARCH_SLICE_SECONDS=
# http:// やプライベートネットワークへの接続を例外的に許可するホスト（ローカルLLM用）
# LLM_ALLOWED_PRIVATE_HOSTS=localhost:11434,127.0.0.1:11434
# 外部APIへの通信に使う HTTP CONNECT プロキシ（社内プロキシ環境向け）
# LLM_EGRESS_PROXY_URL=http://proxy.example.internal:8080
