# ---- Basic認証（必須。本番環境では未設定だと起動しません） ----
# 値はここに書かず、.env.local またはホスティング環境の環境変数に設定してください。
BASIC_AUTH_USERNAME=
# 12文字以上
BASIC_AUTH_PASSWORD=

# ---- APIキー暗号化用の鍵（必須。32バイトを base64 または 16進数64文字で） ----
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# この鍵を変更すると、保存済みのAPIキーは復号できなくなります（再登録が必要）。
API_KEY_ENCRYPTION_KEY=

# ---- 任意 ----
# 研究データ（暗号化済みAPIキー・使用量・実験結果）の保存先。既定: .data/research
# RESEARCH_DATA_DIR=
# http:// やプライベートネットワークへの接続を例外的に許可するホスト（ローカルLLM用）
# LLM_ALLOWED_PRIVATE_HOSTS=localhost:11434,127.0.0.1:11434
# 外部APIへの通信に使う HTTP CONNECT プロキシ（社内プロキシ環境向け）
# LLM_EGRESS_PROXY_URL=http://proxy.example.internal:8080
